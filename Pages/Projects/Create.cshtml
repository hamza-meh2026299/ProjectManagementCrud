@page
@model ProjectHub.Pages.Projects.CreateModel
@{
    ViewData["Title"] = "New Project";
}

<div class="page-header">
    <div>
        <h1 class="page-title">New Project</h1>
        <p class="page-subtitle">Fill in the details to create a new project record.</p>
    </div>
    <a asp-page="Index" class="btn btn-secondary">← Back to List</a>
</div>

<div class="card">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Project.Name"></label>
                <input asp-for="Project.Name" class="form-control" id="projName" placeholder="e.g. Website Redesign" />
                <span asp-validation-for="Project.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.Client"></label>
                <input asp-for="Project.Client" class="form-control" id="projClient" placeholder="e.g. Acme Corp" />
                <span asp-validation-for="Project.Client" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.Status"></label>
                <select asp-for="Project.Status" class="form-control" id="projStatus"
                        asp-items="Html.GetEnumSelectList<ProjectHub.Models.ProjectStatus>()"></select>
                <span asp-validation-for="Project.Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.Priority"></label>
                <select asp-for="Project.Priority" class="form-control" id="projPriority"
                        asp-items="Html.GetEnumSelectList<ProjectHub.Models.ProjectPriority>()"></select>
                <span asp-validation-for="Project.Priority" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.StartDate"></label>
                <input asp-for="Project.StartDate" class="form-control" type="date" id="projStart" />
                <span asp-validation-for="Project.StartDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.DueDate"></label>
                <input asp-for="Project.DueDate" class="form-control" type="date" id="projDue" />
                <span asp-validation-for="Project.DueDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.Budget"></label>
                <input asp-for="Project.Budget" class="form-control" type="number" step="0.01" min="0" id="projBudget" placeholder="e.g. 15000.00" />
                <span asp-validation-for="Project.Budget" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Project.TeamLead"></label>
                <input asp-for="Project.TeamLead" class="form-control" id="projLead" placeholder="e.g. Jane Smith" />
                <span asp-validation-for="Project.TeamLead" class="text-danger"></span>
            </div>
            <div class="form-group full-width">
                <label asp-for="Project.Description"></label>
                <textarea asp-for="Project.Description" class="form-control" id="projDesc" placeholder="Brief description of the project scope and goals…"></textarea>
                <span asp-validation-for="Project.Description" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-success">💾 Create Project</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
